# Discord bot token (from the Discord Developer Portal)
DISCORD_TOKEN=

# Mongo URI (MongoDB connection string)
MONGO_URI=

# Server / guild ID where slash commands should be registered
GUILD_ID=

# Bot application/client ID (from the Discord Developer Portal)
CLIENT_ID=

# Bot prefix for prefix-style commands (default: w!)
PREFIX=w!

# Roblox groups API base (optional override)
ROBLOX_API_BASE=https://users.roblox.com
